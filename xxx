import java.util.Scanner;

class Node {
    String studentID;
    String studentName;
    Node next;

    Node(String id, String name) {
        studentID = id;
        studentName = name;
        next = null;
    }
}

class StudentLinkedList {
    Node head;

    void insertAtBeginning(String id, String name) {
        Node newNode = new Node(id, name);
        newNode.next = head;
        head = newNode;
    }

    void insertAtEnd(String id, String name) {
        Node newNode = new Node(id, name);
        if (head == null) {
            head = newNode;
            return;
        }
        Node temp = head;
        while (temp.next != null) {
            temp = temp.next;
        }
        temp.next = newNode;
    }

    void insertAfter(String targetId, String id, String name) {
        Node temp = head;
        while (temp != null && !temp.studentID.equals(targetId)) {
            temp = temp.next;
        }
        if (temp != null) {
            Node newNode = new Node(id, name);
            newNode.next = temp.next;
            temp.next = newNode;
        } else {
            System.out.println("Student ID not found");
        }
    }

    void deleteStudent(String id) {
        if (head == null) {
            System.out.println("List is empty");
            return;
        }
        if (head.studentID.equals(id)) {
            head = head.next;
            System.out.println("Deleted successfully");
            return;
        }
        Node temp = head;
        while (temp.next != null && !temp.next.studentID.equals(id)) {
            temp = temp.next;
        }
        if (temp.next != null) {
            temp.next = temp.next.next;
            System.out.println("Deleted successfully");
        } else {
            System.out.println("Student ID not found");
        }
    }

    void searchStudent(String id) {
        Node temp = head;
        while (temp != null) {
            if (temp.studentID.equals(id)) {
                System.out.println("Found: ID: " + temp.studentID + ", Name: " + temp.studentName);
                return;
            }
            temp = temp.next;
        }
        System.out.println("Student ID not found");
    }

    void displayStudents() {
        if (head == null) {
            System.out.println("List is empty");
            return;
        }
        Node temp = head;
        while (temp != null) {
            System.out.println("ID: " + temp.studentID + ", Name: " + temp.studentName);
            temp = temp.next;
        }
    }
}

public class Q1 {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        StudentLinkedList list = new StudentLinkedList();
        int choice;

        do {
            System.out.println("\n=== STUDENT LINKED LIST ===");
            System.out.println("1. Insert at Beginning");
            System.out.println("2. Insert at End");
            System.out.println("3. Insert After Student ID");
            System.out.println("4. Delete Student");
            System.out.println("5. Search Student");
            System.out.println("6. Display Students");
            System.out.println("7. Exit");
            System.out.print("Enter your choice: ");
            choice = scanner.nextInt();
            scanner.nextLine();

            switch (choice) {
                case 1:
                    System.out.print("Enter Student ID: ");
                    String id1 = scanner.nextLine();
                    System.out.print("Enter Student Name: ");
                    String name1 = scanner.nextLine();
                    list.insertAtBeginning(id1, name1);
                    break;
                case 2:
                    System.out.print("Enter Student ID: ");
                    String id2 = scanner.nextLine();
                    System.out.print("Enter Student Name: ");
                    String name2 = scanner.nextLine();
                    list.insertAtEnd(id2, name2);
                    break;
                case 3:
                    System.out.print("Enter Target Student ID: ");
                    String targetId = scanner.nextLine();
                    System.out.print("Enter New Student ID: ");
                    String id3 = scanner.nextLine();
                    System.out.print("Enter New Student Name: ");
                    String name3 = scanner.nextLine();
                    list.insertAfter(targetId, id3, name3);
                    break;
                case 4:
                    System.out.print("Enter Student ID to Delete: ");
                    String deleteId = scanner.nextLine();
                    list.deleteStudent(deleteId);
                    break;
                case 5:
                    System.out.print("Enter Student ID to Search: ");
                    String searchId = scanner.nextLine();
                    list.searchStudent(searchId);
                    break;
                case 6:
                    list.displayStudents();
                    break;
                case 7:
                    System.out.println("Exiting...");
                    break;
                default:
                    System.out.println("Invalid choice");
            }
        } while (choice != 7);
        scanner.close();
    }
}



