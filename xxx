import java.util.Scanner;
public class MatrixAddition
{

	static Scanner input = new Scanner(System.in);

	public static void insertion(int[][] array, int m, int n)
	{
		for(int i = 0; i < m; i++)
		{
			for(int j = 0; j < n; j++)
			{
				System.out.print("value [" + i + "] [" + j + "] : ");
				array[i][j] = input.nextInt();
				System.out.println();
			}
		}
	}
	
	public static void printArray(int[][] array, int m, int n)
	{
		for(int i = 0; i < m; i++)
		{
			for(int j = 0; j < n; j++)
			{
				System.out.print(array[i][j] + "\t");
			}
			
			System.out.println();
		}
	}
	
	public static void addArrays(int[][] array1, int[][] array2, int[][] array3, int m, int n)
	{
		for(int i = 0; i < m; i++)
		{
			for(int j = 0; j < n; j++)
			{
				array3[i][j] = array1[i][j] + array2[i][j];
			}
			
			System.out.println();
		}
	}
	
	public static void main(String[] args)
	{
		int m = 0, n = 0;
		
		System.out.println("* * * * * This program adds two matrixes * * * * *");
		
		System.out.println("Enter the row number for the matrixes: ");
		m = input.nextInt();
		
		System.out.println("Enter the column number for the matrixes: ");
		n = input.nextInt();
		
		int[][] matrixA = new int[m][n];
		int[][] matrixB = new int[m][n];
		int[][] matrixC = new int[m][n];
		
		System.out.println("Enter the values for your matrixA: ");
		insertion(matrixA, m, n);
		
		System.out.println("matrixA: ");
		printArray(matrixA, m, n);
		
		System.out.println("Enter the values for your matrixB: ");
		insertion(matrixB, m, n);
		
		System.out.println("matrixB: ");
		printArray(matrixB, m, n);
		
		System.out.println("Adding the matrixes together.......*");
		addArrays(matrixA, matrixB, matrixC, m, n);
		
		System.out.println("The added matrix: ");
		printArray(matrixC, m, n);
	}	
}



		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
				
			
