<!DOCTYPE html>
<html>
<head>
    <title>Student Registration Form</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 30px; }
        .box { margin-bottom: 12px; }
        label { display: block; margin-bottom: 4px; font-weight: bold; }
        input, select { width: 250px; padding: 6px; }
        .error { color: red; font-size: 12px; display: block; }
        .success { color: green; font-weight: bold; margin-top: 10px; }
    </style>
</head>
<body>
   
    <h2>Student Registration Form</h2>

    <form onsubmit="return validateForm()">
        <div class="box">
            <label>Student Name:</label>
            <input type="text" id="name">
            <span id="nameError" class="error"></span>
        </div>

        <div class="box">
            <label>Student ID:</label>
            <input type="text" id="studentId">
            <span id="idError" class="error"></span>
        </div>

        <div class="box">
            <label>Email:</label>
            <input type="text" id="email">
            <span id="emailError" class="error"></span>
        </div>

        <div class="box">
            <label>Telephone Number:</label>
            <input type="text" id="phone">
            <span id="phoneError" class="error"></span>
        </div>

        <div class="box">
            <label>Age:</label>
            <input type="number" id="age">
            <span id="ageError" class="error"></span>
        </div>

        <div class="box">
            <label>Course:</label>
            <select id="course">
                <option value="">--Select Course--</option>
                <option value="HTML">HTML</option>
                <option value="Python">Python</option>
                <option value="C++">C++</option>
                <option value="Graphic Design">Graphic Design</option>
            </select>
            <span id="courseError" class="error"></span>
        </div>

        <button type="submit">Submit</button>
        <div id="successMessage" class="success"></div>
    </form>

    <script src="form.js"></script>
</body>
</html>



---JS---

function validateForm() {
    document.getElementById("nameError").innerText = "";
    document.getElementById("idError").innerText = "";
    document.getElementById("emailError").innerText = "";
    document.getElementById("phoneError").innerText = "";
    document.getElementById("ageError").innerText = "";
    document.getElementById("courseError").innerText = "";
    document.getElementById("successMessage").innerText = "";

    let valid = true;

    let name = document.getElementById("name").value.trim();
    if (name === "") {
        document.getElementById("nameError").innerText = "Student Name must not be empty.";
        valid = false;
    }

    let studentId = document.getElementById("studentId").value.trim();
    if (studentId === "") {
        document.getElementById("idError").innerText = "Student ID must not be empty.";
        valid = false;
    }

    let email = document.getElementById("email").value.trim();
    if (email === "" || !email.includes("@")) {
        document.getElementById("emailError").innerText = "Enter a valid email format.";
        valid = false;
    }

    let phone = document.getElementById("phone").value.trim();
    if (phone === "" || phone.length !== 10) {
        document.getElementById("phoneError").innerText = "Telephone number must contain 10 digits.";
        valid = false;
    }

    let age = document.getElementById("age").value.trim();
    if (age === "" || age < 18 || age > 60) {
        document.getElementById("ageError").innerText = "Age must be between 18 and 60.";
        valid = false;
    }

    let course = document.getElementById("course").value;
    if (course === "") {
        document.getElementById("courseError").innerText = "A course must be selected.";
        valid = false;
    }

    if (valid) {
        document.getElementById("successMessage").innerText = "Form submitted successfully!";
    }

    return false;
}

