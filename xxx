    flex: 1;
}

.titleBox h1 {
    margin: 0;
    font-size: 28px;
    color: #ffffff;
}

.titleBox h2 {
    margin-top: 8px;
    font-size: 16px;
    color: #ffffff;
}


/* 6. Header image */

.picBox img {
    width: 150px;
    height: 90px;
    object-fit: cover;
    border: 1px solid #ffffff;
    border-radius: 4px;
}
/* 7. Main two-column layout */

.mainContent {
    display: flex;
    gap: 20px;
    margin-top: 20px;
}

/* 8. Main text area */

.mainTextArea {
    flex: 2;
}

.mainTextArea h3 {
    color: #2c4c73;
    clear: both;
}

.mainTextArea p {
    line-height: 1.6;
    text-align: justify;
}
/* 9. Sidebar / sizeBar */

.sizeBar {
    flex: 1;
    background-color: #b3cde0;
