
/* 1. Page background, font and default spacing */
   body{
	   backgronud-color :  #e0e0e0;
	   font-family : Arial, sans-serif;
	   font size : 14px;
	   margin : 0;
	   padding : 20px;
	   color : #333;
   }
	   
/* 2. Main container: width, centering, border and shadow */
 .container {
    max-width: 900px;
    margin: 0 auto;
    background-color: #ffffff;
    border: 2px solid #2c4c73;
    border-radius: 8px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    overflow: hidden;
}
	 
	 
/* 3. Inner container */

.innerContainer {
    padding: 20px;
}


/* 4. Header: background, height, padding and layout */

.headerBar {
    background-color: #5c93f0;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid #2c4c73;
}
/* 5. Header title and subtitle */

.titleBox {
    flex: 1;
}

.titleBox h1 {
    margin: 0;
    font-size: 28px;
    color: #ffffff;
}

.titleBox h2 {
    margin-top: 8px;
    font-size: 16px;
    color: #ffffff;
}


/* 6. Header image */

.picBox img {
    width: 150px;
    height: 90px;
    object-fit: cover;
    border: 1px solid #ffffff;
    border-radius: 4px;
}
/* 7. Main two-column layout */

.mainContent {
    display: flex;
    gap: 20px;
    margin-top: 20px;
}

/* 8. Main text area */

.mainTextArea {
    flex: 2;
}

.mainTextArea h3 {
    color: #2c4c73;
    clear: both;
}

.mainTextArea p {
    line-height: 1.6;
    text-align: justify;
}
/* 9. Sidebar / sizeBar */

.sizeBar {
    flex: 1;
    background-color: #b3cde0;
    border: 2px solid #2c4c73;
    border-radius: 6px;
    padding: 15px;
}
/* 10. Headings and paragraphs */
/* 11. Feature images */

.featureImage {
    width: 200px;
    height: 130px;
    object-fit: cover;
    float: left;
    margin-right: 15px;
    margin-bottom: 10px;
    border: 1px solid #ccc;
    border-radius: 4px;
}
/* 12. Hyperlinks and :hover effect */

a {
    color: #1a0dab;
    text-decoration: none;
}

a:hover {
    text-decoration: underline;
    color: #d9534f;
}


/* 13. Sidebar labels and details */
.label {
    font-weight: bold;
    margin-bottom: 5px;
    color: #2c4c73;
}

.detail {
    margin-top: 0;
    margin-bottom: 15px;
}
