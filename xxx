
/* 1. Page background, font and default spacing */
   body{
	   backgronud-color :  #e0e0e0;
	   font-family : Arial, sans-serif;
	   font size : 14px;
	   margin : 0;
	   padding : 20px;
	   color : #333;
   }
	   
/* 2. Main container: width, centering, border and shadow */
 .container {
    max-width: 900px;
    margin: 0 auto;
    background-color: #ffffff;
    border: 2px solid #2c4c73;
    border-radius: 8px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    overflow: hidden;
}
	 
	 
/* 3. Inner container */

.innerContainer {
    padding: 20px;
}


/* 4. Header: background, height, padding and layout */

.headerBar {
    background-color: #5c93f0;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid #2c4c73;
}
