<!DOCTYPE html>
<html>
<head>
    <title>Mathematics - Grade 2</title>
</head>
<body onload="newSum()">

    <h2>Mathematics - Grade 2</h2>
    <h3>Addition</h3>
    <p>Count and type the answer</p>

    <!-- Numbers and Stars section -->
    <h3 id="num1Box"></h3>
    <div id="stars1"></div>

    <h3>+</h3>

    <h3 id="num2Box"></h3>
    <div id="stars2"></div>

    <h3>=</h3>
    <input type="text" id="ansBox">
    
    <div id="ansStars"></div>
    <h3 id="resultBox"></h3>

    <br>
    <button onclick="newSum()">New Sum</button>
    <button onclick="checkAnswer()">Check Answer</button>

    <script src="script.js"></script>
</body>
</html>



---JS---

let num1 = 0;
let num2 = 0;

function showStars(count) {
    let stars = "";
    for (let i = 1; i <= count; i++) {
        stars += "* ";
    }
    return stars;
}

function newSum() {
    num1 = Math.floor(Math.random() * 5) + 1;
    num2 = Math.floor(Math.random() * 5) + 1;

    document.getElementById("num1Box").innerHTML = num1;
    document.getElementById("num2Box").innerHTML = num2;

    document.getElementById("stars1").innerHTML = showStars(num1);
    document.getElementById("stars2").innerHTML = showStars(num2);

    document.getElementById("ansBox").value = "";
    document.getElementById("ansStars").innerHTML = "";
    document.getElementById("resultBox").innerHTML = "";
}

function checkAnswer() {
    let userAnswer = document.getElementById("ansBox").value;
    let total = num1 + num2;

    if (userAnswer == total && userAnswer != "") {
        document.getElementById("ansStars").innerHTML = showStars(total);
        document.getElementById("resultBox").innerHTML = "Correct";
    } else {
        document.getElementById("ansStars").innerHTML = "";
        document.getElementById("resultBox").innerHTML = "Wrong";
    }
}


